{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/knowledge-atlas/feedback.schema.json",
  "title": "feedback",
  "type": "object",
  "required": [
    "id",
    "targetId",
    "origin",
    "issue",
    "requestedChange",
    "invariants",
    "scope",
    "status"
