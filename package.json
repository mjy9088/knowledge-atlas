{
  "name": "knowledge-atlas-bootstrap",
  "version": "0.0.1",
  "private": true,
  "description": "Source-grounded interactive knowledge atlas; web canonical, video projection",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "build": "node scripts/validate.mjs && node scripts/build-site.mjs",
    "preview": "node scripts/serve-static.mjs",
    "validate": "node scripts/validate.mjs",
    "test": "node --test tests/*.test.mjs",
    "storyboard": "node scripts/storyboard.mjs",
    "release:check": "node scripts/release-check.mjs",
    "check": "pnpm validate && pnpm test && pnpm test:ui",
    "impact": "node scripts/impact.mjs",
    "preview:manifest": "node scripts/preview-manifest.mjs",
    "render:mp4": "node scripts/encode-mp4.mjs",
    "test:ui": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
